diff --git a/src/llama-moe-cpu.cpp b/src/llama-moe-cpu.cpp
new file mode 100644
index 0000000..154e258
--- /dev/null
+++ b/src/llama-moe-cpu.cpp
@@ -0,0 +1,219 @@
+#include "llama-moe-cpu.h"
+
+#include "ggml-cpp.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+#ifdef MISTRAL_MOE_NVTX
+#include <nvtx3/nvToolsExt.h>
+#endif
+
+struct llama_moe_cpu::impl {
+    struct job {
+        impl * owner;
+        ggml_context_ptr ctx;
+        ggml_backend_buffer_ptr buffer;
+        ggml_cgraph * graph;
+        ggml_tensor * input;
+        ggml_tensor * ids;
+        ggml_tensor * output;
+        int64_t n_expert;
+        bool has_misses = false;
+        bool published = false;
+    };
+
+    ggml_backend_ptr backend;
+    std::map<int, std::unique_ptr<job>> jobs;
+    std::mutex mutex;
+    std::condition_variable cv;
+    job * pending = nullptr;
+    bool stopping = false;
+    ggml_status status = GGML_STATUS_SUCCESS;
+    const bool serial = std::getenv("MISTRAL_CPU_CONCURRENT_SERIAL") != nullptr;
+    uint64_t launches = 0;
+    uint64_t all_hit = 0;
+    uint64_t ready_at_join = 0;
+    std::thread worker;
+
+    explicit impl(int n_threads) {
+        backend.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+        if (!backend || n_threads < 1) {
+            throw std::runtime_error("cannot initialize the Mistral CPU executor");
+        }
+        auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend.get()));
+        auto set_threads = reinterpret_cast<ggml_backend_set_n_threads_t>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads"));
+        if (!set_threads) {
+            throw std::runtime_error("CPU executor backend cannot set its thread count");
+        }
+        set_threads(backend.get(), n_threads);
+        worker = std::thread([this] {
+            std::unique_lock<std::mutex> lock(mutex);
+            for (;;) {
+                cv.wait(lock, [this] { return pending || stopping; });
+                if (!pending) {
+                    return;
+                }
+                job * current = pending;
+                lock.unlock();
+                const auto result = compute(*current);
+                lock.lock();
+                status = result;
+                pending = nullptr;
+                cv.notify_all();
+            }
+        });
+    }
+
+    ~impl() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        cv.notify_all();
+        worker.join(); // Finish even when graph evaluation aborts before the join node.
+        fprintf(stderr, "mistral CPU executor: jobs=%llu, all-hit=%llu, ready-at-join=%llu, mode=%s\n",
+                (unsigned long long) launches, (unsigned long long) all_hit,
+                (unsigned long long) ready_at_join, serial ? "serial-control" : "concurrent");
+    }
+
+    ggml_status compute(job & j) {
+#ifdef MISTRAL_MOE_NVTX
+        nvtxRangePushA("mistral.cpu.experts");
+#endif
+        ggml_status result = GGML_STATUS_SUCCESS;
+        try {
+            result = ggml_backend_graph_compute(backend.get(), j.graph);
+        } catch (...) {
+            result = GGML_STATUS_FAILED;
+        }
+#ifdef MISTRAL_MOE_NVTX
+        nvtxRangePop();
+#endif
+        return result;
+    }
+
+    void wait() {
+        std::unique_lock<std::mutex> lock(mutex);
+        cv.wait(lock, [this] { return pending == nullptr; });
+        GGML_ASSERT(status == GGML_STATUS_SUCCESS);
+    }
+
+    static void join(ggml_tensor * dst, int ith, int nth, void * userdata) {
+        GGML_ASSERT(ith == 0 && nth == 1);
+        auto & j = *static_cast<job *>(userdata);
+        {
+            std::lock_guard<std::mutex> lock(j.owner->mutex);
+            j.owner->ready_at_join += j.owner->pending == nullptr;
+        }
+        j.owner->wait();
+        GGML_ASSERT(j.published);
+        GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(j.output));
+        std::memcpy(dst->data, j.output->data, ggml_nbytes(dst));
+        j.published = false;
+    }
+
+    job & prepare(int il, ggml_tensor * gate_up, ggml_tensor * down, int64_t n_used) {
+        auto it = jobs.find(il);
+        if (it != jobs.end()) {
+            GGML_ASSERT(it->second->ids->ne[0] == n_used);
+            return *it->second;
+        }
+        // This executor is deliberately restricted to the tested Mistral Small 4 layout.
+        if (gate_up->ne[0] != 4096 || gate_up->ne[1] != 4096 || gate_up->ne[2] < 4 || gate_up->ne[2] > 128 || gate_up->ne[3] != 1 ||
+            down->ne[0] != 2048 || down->ne[1] != 4096 || down->ne[2] != gate_up->ne[2] || down->ne[3] != 1 || n_used != 4 ||
+            (gate_up->type != GGML_TYPE_Q4_K && gate_up->type != GGML_TYPE_Q6_K) ||
+            (down->type != GGML_TYPE_Q4_K && down->type != GGML_TYPE_Q6_K) ||
+            !gate_up->buffer || !down->buffer ||
+            !ggml_backend_buffer_is_host(gate_up->buffer) || !ggml_backend_buffer_is_host(down->buffer)) {
+            throw std::runtime_error("unsupported concurrent Mistral expert layout");
+        }
+        auto j = std::make_unique<job>();
+        j->owner = this;
+        j->n_expert = gate_up->ne[2];
+        j->ctx.reset(ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true}));
+        if (!j->ctx) {
+            throw std::runtime_error("cannot allocate CPU executor context");
+        }
+        auto * ctx = j->ctx.get();
+        j->input = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, gate_up->ne[0], 1, 1);
+        j->ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, 1);
+        const auto mm = [&](ggml_tensor * w, ggml_tensor * a) {
+            auto * t = ggml_mul_mat_id(ctx, w, a, j->ids);
+            t->op_params[4] = 1;
+            ggml_prec_set_src(t, GGML_PREC_F32, 1);
+            return t;
+        };
+        auto * gu = mm(gate_up, j->input);
+        const int64_t n_ff = gu->ne[0]/2;
+        auto * gate = ggml_view_3d(ctx, gu, n_ff, n_used, 1, gu->nb[1], gu->nb[2], 0);
+        auto * up = ggml_view_3d(ctx, gu, n_ff, n_used, 1, gu->nb[1], gu->nb[2], n_ff*gu->nb[0]);
+        j->output = mm(down, ggml_swiglu_split(ctx, gate, up));
+        j->graph = ggml_new_graph_custom(ctx, 32, false);
+        ggml_build_forward_expand(j->graph, j->output);
+        j->buffer.reset(ggml_backend_alloc_ctx_tensors(ctx, backend.get()));
+        if (!j->buffer) {
+            throw std::runtime_error("cannot allocate CPU executor tensors");
+        }
+        auto & result = *j;
+        jobs.emplace(il, std::move(j));
+        return result;
+    }
+};
+
+llama_moe_cpu::llama_moe_cpu(int n_threads) : pimpl(new impl(n_threads)) {}
+llama_moe_cpu::~llama_moe_cpu() = default;
+
+ggml_tensor * llama_moe_cpu::make_join(ggml_context * ctx, ggml_tensor * slots, ggml_tensor * gate_up,
+                                      ggml_tensor * down, int il) {
+    auto & j = pimpl->prepare(il, gate_up, down, slots->ne[0]);
+    // The small slot dependency keeps the join after the cache callback. Scheduler fences remain intact.
+    ggml_tensor * args[] = {slots};
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, down->ne[1], slots->ne[0], 1, 1, args, 1, impl::join, 1, &j);
+}
+
+ggml_tensor * llama_moe_cpu::input(int il) {
+    pimpl->wait(); // Own the staging buffer before a DtoH transfer or a new publication.
+    return pimpl->jobs.at(il)->input;
+}
+
+void llama_moe_cpu::launch(int il, const int32_t * ids, const int32_t * slot_map, size_t count) {
+    auto & j = *pimpl->jobs.at(il);
+    GGML_ASSERT(count == (size_t) j.ids->ne[0]);
+    // An aborted graph may leave an unconsumed result; input() already waited for it.
+    j.published = true;
+    auto * miss_ids = static_cast<int32_t *>(j.ids->data);
+    j.has_misses = false;
+    for (size_t i = 0; i < count; ++i) {
+        GGML_ASSERT(ids[i] >= 0 && ids[i] < j.n_expert);
+        miss_ids[i] = slot_map[ids[i]] < 0 ? ids[i] : -1;
+        j.has_misses |= miss_ids[i] >= 0;
+    }
+    ++pimpl->launches;
+    if (!j.has_misses) {
+        ++pimpl->all_hit;
+        std::memset(j.output->data, 0, ggml_nbytes(j.output));
+    } else if (pimpl->serial) {
+        pimpl->status = pimpl->compute(j);
+    } else {
+        std::lock_guard<std::mutex> lock(pimpl->mutex);
+        GGML_ASSERT(!pimpl->pending);
+        pimpl->pending = &j;
+        pimpl->cv.notify_one();
+    }
+}
+
+size_t llama_moe_cpu::buffer_size() const {
+    size_t bytes = 0;
+    for (const auto & entry : pimpl->jobs) {
+        bytes += ggml_backend_buffer_get_size(entry.second->buffer.get());
+    }
+    return bytes;
+}
diff --git a/src/llama-moe-cpu.h b/src/llama-moe-cpu.h
new file mode 100644
index 0000000..ca6d53a
--- /dev/null
+++ b/src/llama-moe-cpu.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <memory>
+
+// Private single-token executor. Its tensors and CPU backend are independent of the scheduler.
+class llama_moe_cpu {
+public:
+    static constexpr int graph_tag = 0x435055;
+
+    explicit llama_moe_cpu(int n_threads);
+    ~llama_moe_cpu();
+
+    ggml_tensor * make_join(ggml_context * ctx, ggml_tensor * slots, ggml_tensor * gate_up,
+                           ggml_tensor * down, int il);
+    ggml_tensor * input(int il);
+    void launch(int il, const int32_t * ids, const int32_t * slot_map, size_t count);
+    size_t buffer_size() const;
+
+private:
+    struct impl;
+    std::unique_ptr<impl> pimpl;
+};
diff --git a/tests/test-mistral-moe-cpu.cpp b/tests/test-mistral-moe-cpu.cpp
new file mode 100644
index 0000000..bf82ad5
--- /dev/null
+++ b/tests/test-mistral-moe-cpu.cpp
@@ -0,0 +1,105 @@
+#include "../src/llama-moe-cpu.h"
+#include "ggml-cpp.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static void initialize_weight(ggml_tensor * w) {
+    std::vector<float> row(w->ne[0]);
+    std::vector<uint8_t> quant(ggml_row_size(w->type, w->ne[0]));
+    for (int64_t e = 0; e < w->ne[2]; ++e) {
+        for (int64_t k = 0; k < w->ne[0]; ++k) {
+            row[k] = 0.01f*std::sin(float(k*17 + e*73));
+        }
+        ggml_quantize_chunk(w->type, row.data(), quant.data(), 0, 1, w->ne[0], nullptr);
+        for (int64_t r = 0; r < w->ne[1]; ++r) {
+            std::memcpy((char *) w->data + e*w->nb[2] + r*w->nb[1], quant.data(), quant.size());
+        }
+    }
+}
+
+static void test_type(ggml_type down_type) {
+    ggml_backend_ptr cpu(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+    GGML_ASSERT(cpu);
+    auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(cpu.get()));
+    auto set_threads = reinterpret_cast<ggml_backend_set_n_threads_t>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads"));
+    GGML_ASSERT(set_threads);
+    set_threads(cpu.get(), 4);
+    ggml_context_ptr ctx(ggml_init({64*ggml_tensor_overhead() + 3*ggml_graph_overhead_custom(32, false), nullptr, true}));
+    auto * gu_w = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_Q4_K, 4096, 4096, 8);
+    auto * down_w = ggml_new_tensor_3d(ctx.get(), down_type, 2048, 4096, 8);
+    // Allocate weights before the executor validates their host residency.
+    ggml_backend_buffer_ptr weights(ggml_backend_alloc_ctx_tensors(ctx.get(), cpu.get()));
+    GGML_ASSERT(weights);
+    initialize_weight(gu_w);
+    initialize_weight(down_w);
+
+    auto * x = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, 4096, 1, 1);
+    auto * miss = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 4, 1);
+    auto * slots = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 4, 1);
+    auto * gu = ggml_mul_mat_id(ctx.get(), gu_w, x, miss);
+    gu->op_params[4] = 1;
+    ggml_prec_set_src(gu, GGML_PREC_F32, 1);
+    auto * gate = ggml_view_3d(ctx.get(), gu, 2048, 4, 1, gu->nb[1], gu->nb[2], 0);
+    auto * up = ggml_view_3d(ctx.get(), gu, 2048, 4, 1, gu->nb[1], gu->nb[2], 2048*sizeof(float));
+    auto * expected = ggml_mul_mat_id(ctx.get(), down_w, ggml_swiglu_split(ctx.get(), gate, up), miss);
+    expected->op_params[4] = 1;
+    ggml_prec_set_src(expected, GGML_PREC_F32, 1);
+    auto * reference = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(reference, expected);
+
+    auto executor = std::make_unique<llama_moe_cpu>(4);
+    auto * actual = executor->make_join(ctx.get(), slots, gu_w, down_w, 0);
+    auto * joined = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(joined, actual);
+    // A second layer checks the single worker's cross-layer ownership barrier.
+    executor->make_join(ctx.get(), slots, gu_w, down_w, 1);
+    ggml_backend_buffer_ptr scratch(ggml_backend_alloc_ctx_tensors(ctx.get(), cpu.get()));
+    GGML_ASSERT(scratch);
+
+    for (int iteration = 0; iteration < 50; ++iteration) {
+        const int n_miss = iteration % 5;
+        int32_t ids[4];
+        int32_t map[8];
+        for (int & v : map) { v = -1; }
+        for (int i = 0; i < 4; ++i) {
+            ids[i] = (iteration + 2*i) % 8;
+            map[ids[i]] = i < n_miss ? -1 : i;
+            static_cast<int32_t *>(miss->data)[i] = i < n_miss ? ids[i] : -1;
+        }
+        for (int k = 0; k < 4096; ++k) {
+            static_cast<float *>(x->data)[k] = (iteration % 2 ? 64.0f : 1.0f)*std::sin(float(k*13 + iteration));
+        }
+        auto * input = executor->input(0);
+        std::memcpy(input->data, x->data, ggml_nbytes(x));
+        executor->launch(0, ids, map, 4);
+        // The worker must use its copied IDs, not these caller-owned arrays.
+        std::memset(ids, 0xff, sizeof(ids));
+        std::memset(map, 0xff, sizeof(map));
+        GGML_ASSERT(ggml_backend_graph_compute(cpu.get(), reference) == GGML_STATUS_SUCCESS);
+        GGML_ASSERT(ggml_backend_graph_compute(cpu.get(), joined) == GGML_STATUS_SUCCESS);
+        GGML_ASSERT(std::memcmp(actual->data, expected->data, ggml_nbytes(actual)) == 0);
+        for (int64_t i = 0; i < ggml_nelements(actual); ++i) {
+            GGML_ASSERT(std::isfinite(static_cast<float *>(actual->data)[i]));
+        }
+    }
+    // Simulate an aborted evaluation: publish, skip join, then reuse for another layer.
+    int32_t ids[] = {0, 1, 2, 3};
+    int32_t map[] = {-1, -1, -1, -1, -1, -1, -1, -1};
+    std::memcpy(executor->input(0)->data, x->data, ggml_nbytes(x));
+    executor->launch(0, ids, map, 4);
+    std::memcpy(executor->input(1)->data, x->data, ggml_nbytes(x));
+    executor->launch(1, ids, map, 4);
+    executor.reset(); // Outstanding work must finish before tensor/weight destruction.
+    printf("%s: 50 bitwise checks, caller-buffer poisoning, cross-layer reuse and pending destruction passed\n", ggml_type_name(down_type));
+}
+
+int main() {
+    ggml_backend_load_all();
+    test_type(GGML_TYPE_Q4_K);
+    test_type(GGML_TYPE_Q6_K);
+    return 0;
+}
