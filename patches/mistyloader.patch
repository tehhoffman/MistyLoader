+        const char * weights, const char * activations, const char * ids, char * output,
+        int64_t k, int64_t rows, int64_t channels,
+        size_t w_row, size_t w_expert, size_t a_channel, size_t a_token,
+        size_t ids_token, size_t out_channel, size_t out_token, bool masked) {
+    const int lane = threadIdx.x % 32;
+    const int64_t row = int64_t(blockIdx.x) * 4 + threadIdx.x / 32;
+    if (row >= rows) {
+        return;
+    }
+    const int slot = blockIdx.y;
+    const int token = blockIdx.z;
+    const int expert = reinterpret_cast<const int32_t *>(ids + token * ids_token)[slot];
+    if (masked && expert == -1) {
+        if (lane == 0) {
+            reinterpret_cast<float *>(output + slot * out_channel + token * out_token)[row] = 0.0f;
+        }
+        return;
+    }
+    const char * w = weights + expert * w_expert + row * w_row;
+    const float * a = reinterpret_cast<const float *>(activations + (slot % channels) * a_channel + token * a_token);
+    float sum = 0.0f;
+    for (int64_t ib = 0; ib < k / QK_K; ++ib) {
+#pragma unroll
+        for (int group = 0; group < 8; ++group) {
+            const int64_t col = ib*QK_K + group*32 + lane;
+            float v;
+            if constexpr (type == GGML_TYPE_Q4_K) {
+                const block_q4_K & b = reinterpret_cast<const block_q4_K *>(w)[ib];
+                uint8_t scale, min;
+                get_scale_min_k4(group, b.scales, scale, min);
+                const int q = (b.qs[(group / 2)*32 + lane] >> (4*(group % 2))) & 15;
+                v = float(__low2half(b.dm))*scale*q - float(__high2half(b.dm))*min;
+            } else {
+                const block_q6_K & b = reinterpret_cast<const block_q6_K *>(w)[ib];
+                const int half = group / 4;
+                const int sub = group % 4;
+                const int lo = (b.ql[half*64 + (sub % 2)*32 + lane] >> (sub >= 2 ? 4 : 0)) & 15;
+                const int hi = (b.qh[half*32 + lane] >> (2*sub)) & 3;
+                v = float(b.d)*b.scales[half*8 + sub*2 + lane/16]*((lo | (hi << 4)) - 32);
+            }
+            sum = fmaf(v, a[col], sum);
+        }
+    }
+    for (int offset = 16; offset > 0; offset /= 2) {
+        sum += __shfl_down_sync(0xffffffff, sum, offset);
+    }
+    if (lane == 0) {
+        reinterpret_cast<float *>(output + slot * out_channel + token * out_token)[row] = sum;
+    }
+}
+
+bool ggml_cuda_supports_mmq_f32_input(const ggml_tensor * dst) {
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * a = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    return dst->op == GGML_OP_MUL_MAT_ID &&
+        (w->type == GGML_TYPE_Q4_K || w->type == GGML_TYPE_Q6_K) &&
+        a->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 &&
+        w->nb[0] == ggml_type_size(w->type) && a->nb[0] == sizeof(float) &&
+        ids->nb[0] == sizeof(int32_t) && dst->nb[0] == sizeof(float) &&
+        w->ne[0] % QK_K == 0 && w->ne[3] == 1 && a->ne[3] == 1 && dst->ne[3] == 1 &&
+        dst->ne[1] <= 65535 && dst->ne[2] <= 65535;
+}
+
+void ggml_cuda_mul_mat_id_f32(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_cuda_supports_mmq_f32_input(dst));
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * a = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    const dim3 grid((dst->ne[0] + 3) / 4, dst->ne[1], dst->ne[2]);
+#define LAUNCH(TYPE) mul_mat_id_f32<TYPE><<<grid, 128, 0, ctx.stream()>>>( \
+        (const char *) w->data, (const char *) a->data, (const char *) ids->data, (char *) dst->data, \
+        w->ne[0], dst->ne[0], a->ne[1], w->nb[1], w->nb[2], a->nb[1], a->nb[2], \
+        ids->nb[1], dst->nb[1], dst->nb[2], ggml_get_op_params_i32(dst, 4) == 1)
+    if (w->type == GGML_TYPE_Q4_K) {
+        LAUNCH(GGML_TYPE_Q4_K);
+    } else {
+        LAUNCH(GGML_TYPE_Q6_K);
+    }
+#undef LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+}
